<UserControl x:Class="DolarMoney.Controles.UcrCotacoesDoDia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ucp="clr-namespace:DolarMoney.Comum"
             xmlns:local="clr-namespace:DolarMoney.Controles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="/Comum/Padrao.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="0" Grid.ColumnSpan="9"
                    Style="{StaticResource gstyBorderQuadro}"/>
            
            <ucp:UcrTitulo x:Name="utlCotacoes" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7"
                           Publico_Titulo="Cotações do dia" Publico_VisibilityClose="Collapsed"/>

            <TextBlock Grid.Row="3" Grid.Column="2" Text="Data" Style="{StaticResource gstyTextBlockLabelV}"/>

            <DatePicker x:Name="dtpCotacoes" Grid.Row="3" Grid.Column="4" Style="{StaticResource gstyDatePicker}"
                        SelectedDate="{Binding Path=DataCotacao}"/>

            <Button x:Name="btnPesquisar" Grid.Row="2" Grid.RowSpan="3" Grid.Column="6" Height="36"
                    VerticalAlignment="Center" ToolTip=" Pesquisar " Style="{StaticResource gstyButton}"
                    Click="btnPesquisar_Click">
                <Image Source="/Controles/Edit.png" Margin="4,4,4,4"/>
            </Button>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="0" Grid.ColumnSpan="15"
                    Style="{StaticResource gstyBorderQuadro}"/>

            <ucp:UcrTitulo x:Name="utlCadastro" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="13"
                           Publico_Titulo="Cadastro"
                           Publico_VisibilityClose="Collapsed"/>

            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource gstyTextBlockLabelV}" Text="Ticker:"/>

            <ComboBox x:Name="cboTicker" Grid.Row="3" Grid.Column="4" Style="{StaticResource gstyComboBox}"
                      ItemsSource="{Binding Path=ListaInvestimentos}"
                      DisplayMemberPath="Descricao"
                      SelectionChanged="cboTicker_SelectionChanged"
                      SelectedValue="{Binding Path=CotacaoEdit.IdInvestimento}"
                      SelectedValuePath="Id"/>

            <TextBlock Grid.Row="3" Grid.Column="6" Style="{StaticResource gstyTextBlockLabelV}" Text="Cotação:"/>

            <TextBox x:Name="tbxCotacao" Grid.Row="3" Grid.Column="8"
                     LostFocus="tbxCotacao_LostFocus"
                     PreviewTextInput="tbxCotacao_PreviewTextInput"
                     Style="{StaticResource gstyTextBoxDecimal}"
                     MaxLength="8"/>

            <Button x:Name="btnGravar" Grid.Row="2" Grid.RowSpan="3" Grid.Column="10"
                    Height="36" VerticalAlignment="Center" Style="{StaticResource gstyButton}"
                    Click="btnGravar_Click" ToolTip=" Gravar ">
                <Image Source="/Controles/Save.png" Margin="4,4,4,4" Stretch="Fill"/>
            </Button>

            <Button x:Name="btnLimpar" Grid.Row="2" Grid.RowSpan="3" Grid.Column="12"
                    Height="36" VerticalAlignment="Center" Style="{StaticResource gstyButton}"
                    Click="btnLimpar_Click" ToolTip=" Limpar ">
                <Image Source="/Controles/New.png" Margin="4,4,4,4" Stretch="Fill"/>
            </Button>
        </Grid>

        <DataGrid x:Name="dgrInvestimentos" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                  Style="{StaticResource gstyDataGrid}"
                  ColumnHeaderStyle="{StaticResource gstyDGHeaderC}"
                  ItemsSource="{Binding Path=ListaCotacoes}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Nº" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Numero}" Style="{StaticResource gstyTextBlockDGC}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image x:Name="imgEdit" Source="/Controles/Edit.png"
                                   ToolTip=" Edit "
                                   Style="{StaticResource gstyImageLink}"
                                   MouseLeftButtonDown="imgEdit_MouseLeftButtonDown"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ticker" Width="80" HeaderStyle="{StaticResource gstyDGHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Ticker}" Style="{StaticResource gstyTextBlockDG}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cotacao" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=CotacaoStr}" Style="{StaticResource gstyTextBlockDGR}"
                                       Foreground="{Binding Path=ColorStr}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="C.Anterior" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=CotacaoAnteriorStr}" Style="{StaticResource gstyTextBlockDGR}"
                                       Foreground="{Binding Path=ColorStr}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="%" Width="60" CanUserSort="True"
                                        SortMemberPath="Percentual">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=PercentualStr}" Style="{StaticResource gstyTextBlockDGR}"
                                       Foreground="{Binding Path=ColorStr}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
    </Grid>
</UserControl>
