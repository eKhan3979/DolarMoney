<UserControl x:Class="DolarMoney.Controles2.UcrGraficosAnalise"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ucm="clr-namespace:DolarMoney.Comum"
             xmlns:local="clr-namespace:DolarMoney.Controles2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="/Comum/Padrao.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="1"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="7" Grid.Column="0" Grid.ColumnSpan="19" Style="{StaticResource gstyBorder}"
                Background="#FFFAFAFA"/>

        <ucm:UcrTitulo x:Name="utlAnalise" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="17"
                       Publico_Titulo="Análise Gráfica"
                       Publico_VisibilityClose="Collapsed"/>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="Data Análise" Style="{StaticResource gstyTextBlockLabel}"/>
        <TextBlock Grid.Row="2" Grid.Column="4" Text="Tendência" Style="{StaticResource gstyTextBlockLabel}"/>
        <TextBlock Grid.Row="2" Grid.Column="6" Text="MM1" Style="{StaticResource gstyTextBlockLabel}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="8" Text="MM2" Style="{StaticResource gstyTextBlockLabel}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="10" Text="Ponto Compra" Style="{StaticResource gstyTextBlockLabel}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="12" Text="Ponto Venda" Style="{StaticResource gstyTextBlockLabel}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="14" Text="Expirado" Style="{StaticResource gstyTextBlockLabel}"/>

        <DatePicker x:Name="dtpAnalise" Grid.Row="4" Grid.Column="2" Style="{StaticResource gstyDatePicker}"
                    SelectedDate="{Binding Path=AnaliseAtual.DataAnalise, Mode=TwoWay}"
                    HorizontalContentAlignment="Center"/>

        <ComboBox x:Name="cboTendencia" Grid.Row="4" Grid.Column="4" Style="{StaticResource gstyComboBox}"
                  ItemsSource="{Binding Path=ListaTendencia}" Height="30"
                  DisplayMemberPath="Tendencia"
                  SelectedValuePath="IdTendencia"
                  SelectedValue="{Binding Path=AnaliseAtual.IdTendencia}"/>

        <TextBox x:Name="tbkDiasMM1" Grid.Row="4" Grid.Column="6" Style="{StaticResource gstyTextBoxReadOnlyC}"
                 Text="{Binding Path=AnaliseAtual.DiasMM1}"/>

        <TextBox x:Name="tbkDiasMM2" Grid.Row="4" Grid.Column="8" Style="{StaticResource gstyTextBoxReadOnlyC}"
                 Text="{Binding Path=AnaliseAtual.DiasMM2}"/>

        <DatePicker x:Name="dtpMM1" Grid.Row="4" Grid.Column="10" Style="{StaticResource gstyDatePicker}"
                    SelectedDate="{Binding Path=AnaliseAtual.DataCompra}"
                    HorizontalContentAlignment="Center"/>

        <DatePicker x:Name="dtpMM2" Grid.Row="4" Grid.Column="12" Style="{StaticResource gstyDatePicker}"
                    SelectedDate="{Binding Path=AnaliseAtual.DataVenda}"
                    HorizontalContentAlignment="Center"/>

        <ComboBox x:Name="cboExpirado" Grid.Row="4" Grid.Column="14" Style="{StaticResource gstyComboBox}"
                  ItemsSource="{Binding Path=ListaExpirado}" Height="30"
                  DisplayMemberPath="Descricao"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding Path=AnaliseAtual.Expirado}"/>

        <Button x:Name="btnSalvar" Grid.Row="2" Grid.RowSpan="3" Grid.Column="16" Style="{StaticResource gstyButton}"
                Height="42" Width="42" VerticalAlignment="Bottom"
                Click="btnSalvar_Click" ToolTip=" Salvar ">
            <Image Source="/Controles2/Save.png" Style="{StaticResource gstyImageLink}"/>
        </Button>

    </Grid>
</UserControl>