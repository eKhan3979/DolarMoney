<UserControl x:Class="DolarMoney.Controles2.UcrGraficos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sct="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:DolarMoney.Controles2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="/Comum/Padrao.xaml"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:UcrGraficosParametros x:Name="ucrParametros" Grid.Row="0" Grid.Column="0" 
                                         Evento_Analises="ucrParametros_Evento_Analises"
                                         Evento_Pesquisar="ucrParametros_Evento_Pesquisar"
                                         Publico_Titulo="Gráfico de Médias Móveis"/>

            <local:UcrGraficosAnalise x:Name="ucrAnalise" Grid.Row="0" Grid.Column="2"
                                      Evento_Gravar="ucrAnalise_Evento_Gravar"/>
        </Grid>

        <DataGrid x:Name="dgrCotacoes" Grid.Row="2" Grid.Column="0"
                  Style="{StaticResource gstyDataGrid}"
                  ItemsSource="{Binding Path=ListaCotacoes}"
                  ColumnHeaderStyle="{StaticResource gstyDGHeaderC}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Nº" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Numero}" Style="{StaticResource gstyTextBlockDGC}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Data Cotação" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Dd_Mm_Yyyy}" Style="{StaticResource gstyTextBlockDGC}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cotação" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=ValorCotacaoStr}" Style="{StaticResource gstyTextBlockDGC}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource gstyBorder}">
            <sct:WpfPlot x:Name="sctGrafico" />
        </Border>

        <Grid x:Name="grdTendenciasAtuais" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
              Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0" Grid.ColumnSpan="5"
                    Style="{StaticResource gstyBorder}" Background="#FFF0F0F0" Opacity="0.86">
            </Border>

            <local:UcrGraficosTendencias x:Name="ucrTendencias" Grid.Row="2" Grid.Column="2"
                                         Evento_Fechar="ucrTendencias_Evento_Fechar"/>

        </Grid>

    </Grid>
</UserControl>